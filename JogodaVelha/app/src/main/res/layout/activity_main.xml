<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvScoreX"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jogador X: 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:id="@+id/tvScoreDraws"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Empates: 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#757575"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:id="@+id/tvScoreO"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jogador O: 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1976D2"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Turno do Jogador: X"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:textColor="#333333"/>

    <GridLayout
        android:id="@+id/gridLayoutBoard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rowCount="3"
        android:columnCount="3"
        android:layout_marginBottom="32dp">

        <Button android:id="@+id/btn00" style="@style/GameButton" />
        <Button android:id="@+id/btn01" style="@style/GameButton" />
        <Button android:id="@+id/btn02" style="@style/GameButton" />

        <Button android:id="@+id/btn10" style="@style/GameButton" />
        <Button android:id="@+id/btn11" style="@style/GameButton" />
        <Button android:id="@+id/btn12" style="@style/GameButton" />

        <Button android:id="@+id/btn20" style="@style/GameButton" />
        <Button android:id="@+id/btn21" style="@style/GameButton" />
        <Button android:id="@+id/btn22" style="@style/GameButton" />

    </GridLayout>


    <Button
        android:id="@+id/btnReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reiniciar Partida"
        android:textSize="16sp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"/>

</LinearLayout>